APP_ENV=local
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
CORS_ORIGINS=http://127.0.0.1:4173,http://localhost:4173

# 로컬 개발은 `npm run db:start`가 출력하는 값을 사용합니다.
# production에서는 서울 운영 프로젝트 Ref와 URL을 배포 secret으로 주입합니다.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PROJECT_REF=
SUPABASE_PUBLISHABLE_KEY=local_publishable_replace_me

# 서버 전용 비밀키입니다. 브라우저 번들, NEXT_PUBLIC_ 변수, Git에 넣지 마세요.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# 휴대전화 중복 조회용 HMAC 비밀값입니다. 32자 이상의 무작위 값을 서버 secret으로만 저장합니다.
ACCOUNT_PHONE_PEPPER=replace_with_at_least_32_random_characters

# 고객 이름을 AES-256-GCM으로 암호화하는 서버 전용 32바이트 Base64 키입니다.
# 운영에서는 secret manager에 저장하고 Git·로그·브라우저에 노출하지 마세요.
RESERVATION_PII_KEY_BASE64=replace_with_base64_encoded_32_byte_key
RESERVATION_PII_KEY_VERSION=v1
# Previous version keys only; use a secret manager in deployed environments.
RESERVATION_PII_KEYRING_JSON={}
# Optional: active administrator profile used by the in-process transition/PII-retention worker.
RESERVATION_SCHEDULER_ACTOR_PROFILE_ID=
RESERVATION_SCHEDULER_INTERVAL_SECONDS=60

# Google Cloud Console에서 Drive API를 활성화한 서버 전용 OAuth 자격증명입니다.
# 전용 운영 계정이 만든 비공개 루트 폴더만 drive.file 범위로 관리합니다.
GOOGLE_DRIVE_CLIENT_ID=replace_me.apps.googleusercontent.com
GOOGLE_DRIVE_CLIENT_SECRET=replace_me
GOOGLE_DRIVE_REFRESH_TOKEN=replace_me
GOOGLE_DRIVE_ROOT_FOLDER_ID=replace_me
