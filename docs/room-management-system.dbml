  terminal_at timestamptz
  reason_code text
  indexes {
    (outbox_id, subscription_id) [unique]
    (next_attempt_at, id) [name: 'notification_delivery_targets_due_idx']
  }
  Note: '#111 exact subscription/version/revision target; 2-minute fenced lease, no envelope copy.'
}

Table private.notification_delivery_attempts {
