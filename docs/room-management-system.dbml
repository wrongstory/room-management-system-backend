Ref: public.bomb_room_reports.decided_by > public.profiles.id
Ref: public.inspection_decisions.submission_id - public.cleaning_submissions.id
Ref: public.inspection_decisions.decided_by > public.profiles.id
Ref: public.earnings.submission_id - public.cleaning_submissions.id
Ref: public.earnings.maid_profile_id > public.profiles.id
Ref: public.payroll_cycles.maid_profile_id > public.profiles.id
Ref: public.payroll_cycles.payment_started_by > public.profiles.id
