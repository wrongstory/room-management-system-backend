  indexes {
    (subscription_id, revision_no) [unique]
    (profile_id, created_at, id)
  }
  Note: '#110 immutable non-plaintext provenance, retained 90 days after logical retirement. #112 delivery uses only the exact bound VAPID key version; legacy NULL fails closed.'
}

Table private.web_push_subscription_secrets {
