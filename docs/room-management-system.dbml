Project room_management_system {
  database_type: 'PostgreSQL'
  Note: 'ERD review draft v4. P0/account baseline is on main; issue #1 room/reservation additions are represented as a proposed append-only migration.'
}

Enum app_role {
  developer
  admin
  maid
}

Table assignment_duration_policy_versions {
  id uuid [pk]
  version bigint [not null, unique, note: 'Positive append-only version; admin expectedVersion CAS']
  status text [not null, note: 'draft | confirmed | retired; partial unique confirmed <=1']
  standard_minutes int [not null, note: '>0; no default/demo fallback']
  premium_minutes int [not null, note: '>0']
  ocean_premium_minutes int [not null, note: '>0']
  ocean_family_minutes int [not null, note: '>0']
  created_by uuid [not null, ref: > profiles.id]
  created_at timestamptz [not null]
  confirmed_by uuid [ref: > profiles.id]
  confirmed_at timestamptz
  indexes {
    created_by
    confirmed_by
  }
  Note: 'Issue #29 feature. RLS RPC-only. Confirmed/retired require confirmation metadata. Immutable values, no DELETE; only confirmed→retired lifecycle update. No confirmed seed. Preview reads without writes.'
}

Enum account_status {
  active
  deactivation_pending
  upload_only
  inactive
  departed
}

Enum availability_status {
  submitted
  superseded
}

Enum availability_request_status {
  pending
  approved
  rejected
}

Enum cleaning_kind {
  checkout
  stayover
  additional
  reclean
}

Enum cleaning_target_status {
  unassigned
  draft_assigned
  notified
  in_progress
  upload_pending
  inspection_pending
  approved
  rejected
  cancelled
}

Enum attempt_status {
  scheduled
  in_progress
  field_completed
  upload_pending
  submitted
  approved
  rejected
  interrupted
  superseded
}

Enum submission_status {
  submitted
  superseded
  approved
  rejected
}

Enum payroll_status {
  open
  paying
  check
  paid
}

Table auth.users {
  id uuid [pk, note: 'Managed by Supabase Auth']
}

Table public.profiles {
  id uuid [pk]
  auth_user_id uuid [not null, unique]
  login_id text [not null, unique]
  login_id_normalized text [not null, unique]
  display_name text [not null]
  display_name_normalized text [not null]
  login_sequence int [not null]
  role app_role [not null]
  status account_status [not null, default: 'active']
  account_lifecycle_version bigint [not null, default: 1, note: '#7B role/status CAS; trigger-owned increment, never caller overwrite']
  phone_last_four text
  phone_lookup_hash text [unique]
  must_change_password boolean [not null, default: true]
  failed_login_count int [not null, default: 0]
  locked_until timestamptz
  deactivated_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table public.login_aliases {
  id uuid [pk]
  profile_id uuid [not null]
  alias text [not null]
  alias_normalized text [not null, unique]
  active boolean [not null, default: true]
  expires_after_new_login boolean [not null, default: false]
  created_at timestamptz [not null]
  retired_at timestamptz
}

Table public.maid_profiles {
  profile_id uuid [pk]
  hired_on date
  departed_on date
  note text
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table public.availability_versions {
  id uuid [pk]
  maid_profile_id uuid [not null]
  week_start date [not null]
  version int [not null]
  status availability_status [not null]
  is_current boolean [not null, default: true]
  submitted_at timestamptz [not null]
  created_at timestamptz [not null]

  Indexes {
    (maid_profile_id, week_start, version) [unique]
    (maid_profile_id, week_start) [unique, note: 'partial unique where is_current']
  }
}

Table public.availability_days {
  id bigint [pk, increment]
  availability_version_id uuid [not null]
  work_date date [not null]
  available boolean [not null]
  created_at timestamptz [not null]

  Indexes {
    (availability_version_id, work_date) [unique]
  }
}

Table public.availability_change_requests {
  id uuid [pk]
  availability_version_id uuid [not null]
  maid_profile_id uuid [not null]
  week_start date [not null]
  source_version int [not null]
  requested_available_dates date[] [not null]
  reason_code text [not null]
  status availability_request_status [not null, default: 'pending']
  requested_at timestamptz [not null]
  decided_by uuid
  decided_at timestamptz
  decision_reason_code text
  approved_version_id uuid
  created_at timestamptz [not null]
}

Table public.room_types {
  id uuid [pk]
  code text [not null, unique]
  name text [not null]
  base_cleaning_fee int [not null, note: 'KRW integer']
  default_duration_minutes int [not null]
  default_guest_count int [not null]
  max_guest_count int [not null]
  active boolean [not null, default: true]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table public.rooms {
  id uuid [pk]
  room_number text [not null, unique]
  room_type_id uuid [not null]
  elevator_zone text
  data_status text [not null]
  occupancy_override text
  state_version bigint [not null, default: 1]
  operation_suspended_at timestamptz
  operation_suspended_reason text
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table public.reservations {
  id uuid [pk]
  room_id uuid [not null]
  check_in_at timestamptz [not null]
  check_out_at timestamptz [not null]
  guest_count int [not null]
  status text [not null]
  guest_name_encrypted text
  preparation_obligation_id uuid [not null]
  checkout_obligation_id uuid [not null]
  version bigint [not null, default: 1]
  created_by uuid [not null]
  updated_by uuid [not null]
  actual_check_in_at timestamptz
  actual_checkout_at timestamptz
  cancelled_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  Note: 'PostgreSQL exclusion constraint prevents overlapping active ranges for the same room.'
}

Table public.reservation_schedule_revisions {
  id uuid [pk]
  reservation_id uuid [not null]
  version bigint [not null]
  room_id uuid [not null]
  check_in_at timestamptz [not null]
  check_out_at timestamptz [not null]
  guest_count int [not null]
  reason_code text [not null]
  actor_profile_id uuid [not null]
  effective_at timestamptz [not null]
  recorded_at timestamptz [not null]

  Indexes {
    (reservation_id, version) [unique]
  }
}

Table public.preparation_obligations {
  id uuid [pk]
  reservation_id uuid [not null, unique]
  room_id uuid [not null]
  status text [not null]
  current_attempt_id uuid
  approved_submission_id uuid [unique]
  version bigint [not null]
  invalidated_reason_code text
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table private.preparation_proof_usages {
  id uuid [pk]
  preparation_obligation_id uuid [not null]
  reservation_id uuid [not null]
  room_id uuid [not null]
  approved_submission_id uuid [not null, unique]
  cleaning_attempt_id uuid [not null]
  recorded_at timestamptz [not null]

  Note: 'Append-only consumption ledger. One approved submission can prove exactly one preparation obligation, including after that obligation is invalidated.'
}

Table public.checkout_cleaning_obligations {
  id uuid [pk]
  reservation_id uuid [not null, unique]
  room_id uuid [not null]
  status text [not null]
  original_service_date date [not null]
  effective_service_date date [not null]
  available_from timestamptz [not null]
  due_at timestamptz
  planned_cleaning_target_id uuid [unique]
  current_cleaning_target_id uuid [unique]
  version bigint [not null]
  cancelled_at timestamptz
  cancellation_reason_code text
  created_by uuid [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  Note: 'planned target is created with the reservation; private requires no current target and forbids execution. Actual checkout promotes the same planned identity to materialized/current. Cancellation preserves identity and soft cancels target/assignments. Composite FK ties planned target to obligation/reservation/room.'
}

Table public.room_occupancy_events {
  id uuid [pk]
  event_key text [not null, unique]
  room_id uuid [not null]
  reservation_id uuid [not null]
  event_type text [not null]
  before_state jsonb
  after_state jsonb [not null]
  reason_code text [not null]
  actor_profile_id uuid [not null]
  effective_at timestamptz [not null]
  recorded_at timestamptz [not null]
}

Table public.room_operation_blocks {
  id uuid [pk]
  room_id uuid [not null]
  reason_code text [not null]
  starts_at timestamptz [not null]
  ends_at timestamptz
  created_by uuid [not null]
  created_at timestamptz [not null]
  released_by uuid
  released_at timestamptz
  release_reason_code text
  version bigint [not null]
}

Table public.room_issues {
  id uuid [pk]
  room_id uuid [not null]
  category text [not null]
  severity text [not null]
  blocks_guest_assignment boolean [not null, default: false]
  description text
  status text [not null]
  reported_by uuid [not null]
  resolved_by uuid
  reported_at timestamptz [not null]
  resolved_at timestamptz
  resolution_reason_code text
  version bigint [not null]
}

Table public.room_candle_events {
  id uuid [pk]
  room_id uuid [not null]
  count_before int [not null]
  count_after int [not null]
  physically_verified boolean [not null, default: false]
  reason_code text [not null]
  actor_profile_id uuid [not null]
  effective_at timestamptz [not null]
  recorded_at timestamptz [not null]
}

Table public.room_pin_sync_events {
  id uuid [pk]
  room_id uuid [not null]
  sync_status text [not null]
  pin_version bigint
  reason_code text [not null]
  actor_profile_id uuid [not null]
  effective_at timestamptz [not null]
  recorded_at timestamptz [not null]
}

Table public.room_pin_access_leases {
  id uuid [pk]
  room_id uuid [not null]
  reservation_id uuid
  cleaning_target_id uuid [not null]
  assignment_id uuid [not null]
  attempt_id uuid [not null]
  pin_version bigint [not null]
  issued_to uuid [not null]
  issued_at timestamptz [not null]
  expires_at timestamptz [not null]
  revealed_at timestamptz
  revoked_at timestamptz
  revoke_reason_code text

  Note: 'Room/reservation/target/current assignment/current attempt/maid/latest verified PIN version are one enforced work contract.'
}

Table public.cleaning_template_versions {
  id uuid [pk]
  room_type_id uuid [not null]
  cleaning_kind cleaning_kind [not null]
  version int [not null]
  status text [not null]
  duration_minutes int [not null]
  photo_slots jsonb [not null, note: 'Legacy JSON retained. Published payload immutable; explicit v7+ checkout counts/required tv-on validated. No implicit duration-policy confirmation.']
  published_at timestamptz
  created_by uuid [not null]
  created_at timestamptz [not null]

  Indexes {
    (room_type_id, cleaning_kind, version) [unique]
  }
}

Table private.photo_template_slots {
  id uuid [pk]
  template_version_id uuid [not null]
  slot_key text [not null]
  display_order int [not null]
  required boolean [not null, default: true]
  slot_snapshot jsonb [not null, note: 'Exact original slot object including section/label/description/repeated instance metadata; absent legacy values not invented.']

  Indexes {
    (template_version_id, slot_key) [unique]
    (template_version_id, display_order) [unique]
  }
  Note: '#30 immutable rows; private RLS/no client or service-role grants. No photo HTTP is exposed.'
}

Table private.target_photo_snapshot_contracts {
  cleaning_target_id uuid [pk, ref: > public.cleaning_targets.id]
  ready boolean [not null]
  frozen_snapshot jsonb [not null]
  created_at timestamptz [not null]
  Note: 'Immutable target-creation JSON bridge. Existing empty/unprovable JSON stays ready=false, never latest-template backfill or zero-photo completion.'
}

Table private.target_photo_slot_snapshots {
  id uuid [pk]
  cleaning_target_id uuid [not null, ref: > private.target_photo_snapshot_contracts.cleaning_target_id]
  template_version_id uuid [not null, note: 'Historical snapshot identity, intentionally not current catalog FK.']
  slot_key text [not null]
  display_order int [not null]
  required boolean [not null]
  slot_snapshot jsonb [not null]
  Indexes {
    (id, cleaning_target_id) [unique]
    (cleaning_target_id, slot_key) [unique]
    (cleaning_target_id, display_order) [unique]
    template_version_id
  }
}

Table private.attempt_photo_versions {
  id uuid [pk]
  cleaning_attempt_id uuid [not null]
  cleaning_target_id uuid [not null]
  target_photo_slot_id uuid [not null]
  version bigint [not null]
  validation_status text [not null, note: 'pending / verified / failed; verified is owner-only model metadata, not client or real byte verification in #30.']
  sha256 text [not null]
  mime_type text [not null]
  size_bytes int [not null]
  uploaded_at timestamptz [not null]
  purge_after timestamptz [not null, note: 'Immutable uploaded_at + 168 hours; resubmission does not reset.']
  Indexes {
    (id, cleaning_attempt_id, cleaning_target_id, target_photo_slot_id, version) [unique]
    (cleaning_attempt_id, target_photo_slot_id, version) [unique]
    (target_photo_slot_id, cleaning_target_id)
    cleaning_target_id
    (purge_after, id)
  }
  Note: 'Immutable attempt-scoped metadata. No Drive locator or binary. Old interrupted and new current attempt have different photo versions/pointers even on the same target slot.'
}

Table private.attempt_photo_purge_states {
  photo_version_id uuid [pk, ref: > private.attempt_photo_versions.id]
  purged_at timestamptz [not null]
  Note: 'Append-only purge marker separated from immutable photo version; #9 owns actual provider deletion.'
}

Table private.attempt_photo_current {
  cleaning_attempt_id uuid [not null]
  cleaning_target_id uuid [not null]
  target_photo_slot_id uuid [not null]
  revision bigint [not null]
  photo_version_id uuid
  photo_version bigint
  Indexes {
    (cleaning_attempt_id, target_photo_slot_id) [pk]
    (photo_version_id, cleaning_attempt_id, cleaning_target_id, target_photo_slot_id, photo_version)
    (target_photo_slot_id, cleaning_target_id)
    cleaning_target_id
  }
  Note: 'CAS revision +1; a null pointer means cleared, not deleted history. Mutations automatically append attempt_photo_changes.'
}

Table private.attempt_photo_changes {
  id uuid [pk]
  cleaning_attempt_id uuid [not null]
  cleaning_target_id uuid [not null]
  target_photo_slot_id uuid [not null]
  revision bigint [not null]
  photo_version_id uuid
  photo_version bigint
  occurred_at timestamptz [not null]
  Indexes {
    (cleaning_attempt_id, target_photo_slot_id, revision) [unique]
    (photo_version_id, cleaning_attempt_id, cleaning_target_id, target_photo_slot_id, photo_version)
    (target_photo_slot_id, cleaning_target_id)
    cleaning_target_id
  }
}

Table private.submission_photo_bindings {
  submission_id uuid [not null]
  cleaning_attempt_id uuid [not null]
  cleaning_target_id uuid [not null]
  target_photo_slot_id uuid [not null]
  photo_version_id uuid [not null]
  photo_version bigint [not null]
  Indexes {
    (submission_id, target_photo_slot_id) [pk]
    (photo_version_id, cleaning_attempt_id, cleaning_target_id, target_photo_slot_id, photo_version)
    cleaning_attempt_id
    cleaning_target_id
    target_photo_slot_id
  }
  Note: 'Immutable membership references canonical cleaning_submissions and exact attempt/target/slot/photo version; no provider object or raw payload copy.'
}

Table private.submission_photo_binding_sets {
  submission_id uuid [pk]
  cleaning_attempt_id uuid [not null]
  photo_count int [not null]
  sealed_at timestamptz [not null]
  Indexes {
    (submission_id, cleaning_attempt_id) [unique]
    cleaning_attempt_id
  }
  Note: 'Immutable membership seal, not a duplicate submission entity. Exact current-photo set and completeness required; no later append.'
}

Table private.submission_current_pointers {
  cleaning_attempt_id uuid [pk, ref: > public.cleaning_attempts.id]
  submission_id uuid [not null, unique]
  revision bigint [not null]
  Note: 'CAS references an already existing, sealed canonical submission. #30 does not create a public business submit command or transition attempt/review/ready/earning.'
}

Table public.cleaning_targets {
  id uuid [pk]
  room_id uuid [not null]
  reservation_id uuid
  checkout_obligation_id uuid [unique]
  cleaning_kind cleaning_kind [not null]
  source text [not null]
  source_key text [not null, unique]
  original_service_date date [not null]
  effective_service_date date [not null]
  carryover_count int [not null, default: 0]
  available_from timestamptz
  due_at timestamptz
  status cleaning_target_status [not null]
  assignment_version bigint [not null]
  room_type_snapshot jsonb [not null]
  fee_snapshot int [not null]
  template_snapshot jsonb [not null]
  cancelled_by uuid
  cancelled_at timestamptz
  cancellation_reason_code text
  reclean_of_attempt_id uuid [unique]
  reclean_maid_profile_id uuid
  created_by uuid [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  Note: 'Checkout targets are unique per reservation. Stayover/additional manual requests use stable target IDs and soft cancellation. Rollover validates the proposed next source window before any write: stayover requires the same active occupied reservation and bounded next window/KST date; additional rejects active reservation overlap. Invalid windows are blocked with zero mutation, no auto-cancel/kind conversion. Inspection recleans keep an immutable original attempt and maid link.'
}

Table public.cleaning_target_schedule_revisions {
  id uuid [pk]
  cleaning_target_id uuid [not null]
  revision bigint [not null]
  effective_service_date date [not null]
  available_from timestamptz
  due_at timestamptz
  reason_code text [not null]
  changed_by uuid [not null]
  recorded_at timestamptz [not null]

  Indexes {
    (cleaning_target_id, revision) [unique]
  }
}

Table public.cleaning_assignments {
  id uuid [pk]
  cleaning_target_id uuid [not null]
  maid_profile_id uuid [not null]
  service_date date [not null]
  sequence_number int [not null]
  revision bigint [not null]
  is_current boolean [not null, default: true]
  available_from_snapshot timestamptz
  due_at_snapshot timestamptz
  notified_at timestamptz
  notified_room_id_snapshot uuid [ref: > public.rooms.id, note: 'Captured on first notification; immutable. Legacy unknown stays null, never current-target fallback.']
  notified_room_number_snapshot text [note: 'Room number at notification; nullable legacy metadata.']
  ended_at timestamptz
  change_reason_code text
  changed_by uuid [not null]
  created_at timestamptz [not null]

  Indexes {
    (cleaning_target_id, revision) [unique]
    (maid_profile_id, service_date, sequence_number) [unique, note: 'Partial where is_current']
    (maid_profile_id, cleaning_target_id, revision) [note: 'Partial where notified_at is not null; maid notified history lookup']
    notified_room_id_snapshot [note: 'Partial where not null; snapshot FK lookup']
  }

  Note: 'Partial unique indexes permit one current assignment per target and one current sequence per maid/service date. Target, maid, sequence, revision, schedule snapshots, changer, and created time are immutable. Maid SELECT requires active self plus notified_at; notified superseded history remains visible, unnotified drafts never do. Notification room snapshots never hydrate from later target state.'
}

Table public.assignment_change_requests {
  id uuid [pk]
  cleaning_target_id uuid [not null, ref: > public.cleaning_targets.id]
  assignment_id uuid [not null]
  maid_profile_id uuid [not null, ref: > public.profiles.id]
  request_type text [not null, default: 'cancel_assignment']
  reason_code text [not null]
  reason_detail text [note: '1-200 chars; no sensitive input; admin/self response only, never audit/notification']
  status text [not null, default: 'pending', note: 'pending/approved/rejected/superseded']
  source_assignment_revision bigint [not null]
  source_target_assignment_version bigint [not null]
  requested_at timestamptz [not null]
  decided_by uuid [ref: > public.profiles.id]
  decided_at timestamptz
  decision_reason_code text
  created_at timestamptz [not null]

  Indexes {
    assignment_id [unique, note: 'Partial where status=pending; separate full FK index']
    cleaning_target_id
    (maid_profile_id, requested_at, id)
    (requested_at, id)
    decided_by
  }
  Note: '#27 source identity/terminal decisions immutable, DELETE forbidden. Active admin all/maid self RLS; service-owned command writes. Source assignment ending supersedes pending requests. Schedule narrowing allows exact manual_room_request+additional or stayover_request+stayover only; stayover rechecks active occupied reservation.'
}

Ref: public.assignment_change_requests.(assignment_id, cleaning_target_id, maid_profile_id, source_assignment_revision) > public.cleaning_assignments.(id, cleaning_target_id, maid_profile_id, revision)

Table public.cleaning_attempts {
  id uuid [pk]
  cleaning_target_id uuid [not null]
  assignment_id uuid [not null]
  maid_profile_id uuid [not null]
  attempt_number int [not null]
  status attempt_status [not null]
  assignment_revision bigint [not null]
  execution_version bigint [not null, default: 1, note: '#7A positive CAS version; start/complete increments once, retry does not increment']
  started_at timestamptz
  field_completed_at timestamptz
  ended_at timestamptz
  end_reason text
  template_snapshot jsonb [not null]
  room_snapshot jsonb [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  Indexes {
    (cleaning_target_id, attempt_number) [unique]
    (id, cleaning_target_id) [unique]
  }
  Note: '#28 activates scheduled once. #7A own active maid execution; #7B limited completion/handover/expired scheduled retirement advance CAS. One in_progress per maid. No physical completion implies submission/readiness/earning. Attempt identity and snapshots immutable. Only proven interrupted handover history is excluded from current-work checks; superseded expiry preserves history. #7C adds online-issued lease/offline completion/quarantine and current-attempt admin correction; PIN runtime remains excluded.'
}

Table private.offline_work_leases {
  id uuid [pk]
  actor_profile_id uuid [not null, ref: > public.profiles.id]
  attempt_id uuid [not null, unique, ref: > public.cleaning_attempts.id]
  assignment_id uuid [not null, ref: > public.cleaning_assignments.id]
  assignment_revision bigint [not null]
  execution_version bigint [not null]
  profile_version bigint [not null]
  version bigint [not null, default: 1]
  issued_at timestamptz [not null]
  expires_at timestamptz [not null]
  metadata_expires_at timestamptz [not null]
  Indexes {
    (actor_profile_id, attempt_id)
    assignment_id
    (metadata_expires_at, id)
    (id, actor_profile_id, metadata_expires_at) [unique]
    (id, metadata_expires_at) [unique]
  }
  Note: '#7C online start-with-lease atomically issues exactly one completion lease per attempt; TTL=[issued_at,issued_at+2h), metadata/replay horizon=issued_at+90d. No renewal by changing request key. Separate from PIN and limited grants. Private RLS/no direct grants, immutable until bounded authorized expiry purge.'
}

Table private.offline_work_lease_revocations {
  lease_id uuid [pk, ref: > private.offline_work_leases.id]
  revoked_at timestamptz [not null]
  reason_code text [not null, note: 'ACCOUNT_CHANGED / ATTEMPT_CHANGED']
  metadata_expires_at timestamptz [not null]
  Note: 'Append-only revocation until lease metadata horizon. Profile lifecycle or attempt transition revokes the original lease permanently; normal account restoration cannot restore it.'
}

Table private.offline_completion_events {
  id uuid [pk, note: 'Server-owned record/quarantine identity']
  lease_id uuid [not null, unique, ref: > private.offline_work_leases.id]
  actor_profile_id uuid [not null, ref: > public.profiles.id]
  event_id uuid [not null, note: 'Client stable UUID, expiring metadata only']
  request_hash text [not null]
  occurred_at timestamptz [not null, note: 'Client time claim, never permanent audit payload']
  server_offset_ms bigint [not null]
  normalized_occurred_at timestamptz [not null]
  received_at timestamptz [not null]
  metadata_expires_at timestamptz [not null]
  outcome text [not null, note: 'applied / quarantined']
  reason_code text [note: 'LEASE_EXPIRED / LEASE_REVOKED / ASSIGNMENT_CHANGED / CLOCK_CONFLICT / KST_DATE_CONFLICT']
  response_payload jsonb [not null, note: 'Replay response only until original lease metadata horizon']
  Indexes {
    (actor_profile_id, event_id) [unique]
    (id, metadata_expires_at) [unique]
    (metadata_expires_at, id)
    (received_at, id) [note: 'Descending partial index WHERE outcome=quarantined']
  }
  Note: 'One canonical completion slot per lease bounds rotating UUID attacks. Unknown/foreign lease has no event row. Successful retry replays; changed payload/second UUID conflicts; quarantined retries never auto-promote. Raw UUID/clock/hash/response cannot be copied to permanent command_executions/audit. Strictly no PII/PIN/body/token/IP.'
}

Table private.offline_event_resolutions {
  id uuid [pk]
  event_record_id uuid [not null, unique, ref: > private.offline_completion_events.id]
  actor_profile_id uuid [not null, ref: > public.profiles.id]
  resolution text [not null, note: 'record_only / reject_effect / correction_link']
  idempotency_key text [not null]
  request_hash text [not null]
  response_payload jsonb [not null]
  metadata_expires_at timestamptz [not null]
  Indexes {
    (actor_profile_id, idempotency_key) [unique]
    (metadata_expires_at, id)
  }
  Note: 'One immutable final admin decision. correction_link is a new validated admin command on the same current in_progress attempt, confirming the pre-existing normalized completion time; no arbitrary correctedAt, no resurrection/submission/earning. Only server quarantine ID + fixed resolution remain in permanent domain audit. Expiring resolution receipt is deleted with event metadata.'
}

Ref: private.offline_work_lease_revocations.(lease_id, metadata_expires_at) > private.offline_work_leases.(id, metadata_expires_at)
Ref: private.offline_completion_events.(lease_id, actor_profile_id, metadata_expires_at) > private.offline_work_leases.(id, actor_profile_id, metadata_expires_at)
Ref: private.offline_event_resolutions.(event_record_id, metadata_expires_at) > private.offline_completion_events.(id, metadata_expires_at)

Table private.attempt_capability_grants {
  id uuid [pk]
  actor_profile_id uuid [not null, ref: > public.profiles.id]
  attempt_id uuid [not null, ref: > public.cleaning_attempts.id]
  assignment_id uuid [not null, ref: > public.cleaning_assignments.id]
  assignment_revision bigint [not null]
  kind text [not null, note: 'finish_current / upload_submit / evidence_upload']
  allowed_actions text[] [not null, note: 'Fixed by kind, never arbitrary caller actions']
  issued_at timestamptz [not null]
  expires_at timestamptz [not null, note: 'issued_at + 2h finish; +24h upload; immutable']
  granted_by uuid [not null, ref: > public.profiles.id]
  Indexes {
    (attempt_id, kind) [unique]
    (actor_profile_id, attempt_id)
    assignment_id
    granted_by
  }
  Note: '#7B private immutable ledger. No Data API/direct service-role table access. No token/session ID stored. Latest valid Supabase session + role/status + exact attempt/revision/action + unrevoked hard expiry required every dedicated API call. Different command key cannot renew TTL.'
}

Table private.attempt_capability_revocations {
  capability_id uuid [pk, ref: > private.attempt_capability_grants.id]
  revoked_at timestamptz [not null]
  reason_code text [not null, note: 'FIELD_COMPLETED / HANDOVER / ACCOUNT_CHANGED']
  actor_profile_id uuid [not null, ref: > public.profiles.id]
  Indexes { actor_profile_id }
  Note: 'Immutable append-only revocation; restoring account status never revives a revoked grant.'
}

Table private.attempt_handover_events {
  previous_attempt_id uuid [pk, ref: > public.cleaning_attempts.id]
  next_attempt_id uuid [not null, unique, ref: > public.cleaning_attempts.id]
  actor_profile_id uuid [not null, ref: > public.profiles.id]
  reason_code text [not null, note: 'ADMIN_HANDOVER / DEACTIVATION_HANDOVER']
  occurred_at timestamptz [not null]
  Indexes { actor_profile_id }
  Note: 'Immutable same-target provenance; old interrupted+ended/noncurrent -> new notified scheduled/higher attempt and assignment revisions. No cycles, deletion or snapshot rewrites. Current descendant still blocks scheduling; orphan interrupted is not ignored.'
}

Table public.cleaning_submissions {
  id uuid [pk]
  cleaning_attempt_id uuid [not null]
  client_submission_id uuid [not null, unique]
  version int [not null]
  status submission_status [not null]
  photo_manifest jsonb [not null, note: 'Legacy presentation payload is immutable, never proof of verified upload.']
  issue_snapshot jsonb [not null]
  candle_count int [not null, default: 0]
  bomb_room_snapshot jsonb
  submitted_by uuid [not null]
  submitted_at timestamptz [not null]
  superseded_at timestamptz

  Indexes {
    (cleaning_attempt_id, version) [unique]
    (id, cleaning_attempt_id) [unique]
  }
  Note: 'Canonical immutable submission versions, including unconsumed payloads. Only status/superseded_at remain lifecycle projections. Service-role direct writes revoked; #31 owns future submit command.'
}

Table public.submission_photos {
  id uuid [pk]
  submission_id uuid [not null]
  photo_slot_key text
  evidence_kind text [not null, note: 'template, bomb_room, issue']
  drive_file_id text [not null, unique]
  drive_folder_id text [not null]
  file_name text [not null]
  sha256 text [not null]
  mime_type text [not null]
  size_bytes int [not null]
  width_px int
  height_px int
  upload_status text [not null]
  captured_at timestamptz
  uploaded_at timestamptz [not null]
  purge_after timestamptz [not null, note: 'Always uploaded_at + 7 days']
  delete_attempt_count int [not null, default: 0]
  last_delete_error_code text
  purged_at timestamptz
  created_at timestamptz [not null]

  Indexes {
    submission_id
    purge_after
    (submission_id, photo_slot_key) [unique]
  }

  Note: 'Legacy provider-shaped table retained, not the #30 evidence source. Nullable slot key/default uploaded cannot establish verified evidence. Service-role direct writes revoked. Actual provider upload/delete remains #9.'
}

Table public.bomb_room_reports {
