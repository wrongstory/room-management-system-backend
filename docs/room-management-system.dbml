Project room_management_system {
  database_type: 'PostgreSQL'
  Note: 'ERD review draft v4. P0/account baseline is on main; issue #1 room/reservation additions are represented as a proposed append-only migration.'
}

Enum app_role {
  admin
  maid
}

Enum account_status {
  active
  deactivation_pending
  upload_only
  inactive
  departed
}

Enum availability_status {
  draft
  submitted
  superseded
}

Enum request_status {
  pending
  approved
  rejected
  cancelled
}

Enum cleaning_kind {
  checkout
  stayover
  additional
  reclean
}

Enum cleaning_target_status {
  unassigned
  draft_assigned
  notified
  in_progress
  upload_pending
  inspection_pending
  approved
  rejected
  cancelled
}

Enum attempt_status {
  scheduled
  in_progress
  field_completed
  upload_pending
  submitted
  approved
  rejected
  interrupted
  superseded
}

Enum submission_status {
  submitted
  superseded
  approved
  rejected
}

Enum payroll_status {
  open
  paying
  check
  paid
}

Table auth.users {
  id uuid [pk, note: 'Managed by Supabase Auth']
}

Table public.profiles {
  id uuid [pk]
  auth_user_id uuid [not null, unique]
  login_id text [not null, unique]
  login_id_normalized text [not null, unique]
  display_name text [not null]
  display_name_normalized text [not null]
  login_sequence int [not null]
  role app_role [not null]
  status account_status [not null, default: 'active']
  phone_last_four text
  phone_lookup_hash text [unique]
  must_change_password boolean [not null, default: true]
  failed_login_count int [not null, default: 0]
  locked_until timestamptz
  deactivated_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table public.login_aliases {
  id uuid [pk]
  profile_id uuid [not null]
  alias text [not null]
  alias_normalized text [not null, unique]
  active boolean [not null, default: true]
  expires_after_new_login boolean [not null, default: false]
  created_at timestamptz [not null]
  retired_at timestamptz
}

Table public.maid_profiles {
  profile_id uuid [pk]
  hired_on date
  departed_on date
  note text
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table public.availability_versions {
  id uuid [pk]
  maid_profile_id uuid [not null]
  week_start date [not null]
  version int [not null]
  status availability_status [not null]
  submitted_at timestamptz
  created_at timestamptz [not null]

  Indexes {
    (maid_profile_id, week_start, version) [unique]
  }
}

Table public.availability_days {
  id bigint [pk, increment]
  availability_version_id uuid [not null]
  work_date date [not null]
  available boolean [not null]

  Indexes {
    (availability_version_id, work_date) [unique]
  }
}

Table public.availability_change_requests {
  id uuid [pk]
  availability_version_id uuid [not null]
  requested_days jsonb [not null]
  reason_code text [not null]
  status request_status [not null, default: 'pending']
  requested_at timestamptz [not null]
  decided_by uuid
  decided_at timestamptz
}

Table public.room_types {
  id uuid [pk]
  code text [not null, unique]
  name text [not null]
  base_cleaning_fee int [not null, note: 'KRW integer']
  default_duration_minutes int [not null]
  default_guest_count int [not null]
  max_guest_count int [not null]
  active boolean [not null, default: true]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table public.rooms {
  id uuid [pk]
  room_number text [not null, unique]
  room_type_id uuid [not null]
  elevator_zone text
  data_status text [not null]
  occupancy_override text
  state_version bigint [not null, default: 1]
  operation_suspended_at timestamptz
  operation_suspended_reason text
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table public.reservations {
  id uuid [pk]
  room_id uuid [not null]
  check_in_at timestamptz [not null]
  check_out_at timestamptz [not null]
  guest_count int [not null]
  status text [not null]
  guest_name_encrypted text
  preparation_obligation_id uuid [not null]
  checkout_obligation_id uuid [not null]
  version bigint [not null, default: 1]
  created_by uuid [not null]
  updated_by uuid [not null]
  actual_check_in_at timestamptz
  actual_checkout_at timestamptz
  cancelled_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  Note: 'PostgreSQL exclusion constraint prevents overlapping active ranges for the same room.'
}

Table public.reservation_schedule_revisions {
  id uuid [pk]
  reservation_id uuid [not null]
  version bigint [not null]
  room_id uuid [not null]
  check_in_at timestamptz [not null]
  check_out_at timestamptz [not null]
  guest_count int [not null]
  reason_code text [not null]
  actor_profile_id uuid [not null]
  effective_at timestamptz [not null]
  recorded_at timestamptz [not null]

  Indexes {
    (reservation_id, version) [unique]
  }
}

Table public.preparation_obligations {
  id uuid [pk]
  reservation_id uuid [not null, unique]
  room_id uuid [not null]
  status text [not null]
  current_attempt_id uuid
  approved_submission_id uuid
  version bigint [not null]
  invalidated_reason_code text
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table public.checkout_cleaning_obligations {
  id uuid [pk]
  reservation_id uuid [not null, unique]
  room_id uuid [not null]
  status text [not null]
  original_service_date date [not null]
  effective_service_date date [not null]
  available_from timestamptz [not null]
  due_at timestamptz
  current_cleaning_target_id uuid [unique]
  version bigint [not null]
  cancelled_at timestamptz
  cancellation_reason_code text
  created_by uuid [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  Note: 'materialized requires a current target; private/available require no current target. Cancelled obligations may retain the historical target pointer.'
}

Table public.room_occupancy_events {
  id uuid [pk]
  event_key text [not null, unique]
  room_id uuid [not null]
  reservation_id uuid [not null]
  event_type text [not null]
  before_state jsonb
  after_state jsonb [not null]
  reason_code text [not null]
  actor_profile_id uuid [not null]
  effective_at timestamptz [not null]
  recorded_at timestamptz [not null]
}

Table public.room_operation_blocks {
  id uuid [pk]
  room_id uuid [not null]
  reason_code text [not null]
  starts_at timestamptz [not null]
  ends_at timestamptz
  created_by uuid [not null]
  created_at timestamptz [not null]
  released_by uuid
  released_at timestamptz
  release_reason_code text
  version bigint [not null]
}

Table public.room_issues {
  id uuid [pk]
  room_id uuid [not null]
  category text [not null]
  severity text [not null]
  blocks_guest_assignment boolean [not null, default: false]
  description text
  status text [not null]
  reported_by uuid [not null]
  resolved_by uuid
  reported_at timestamptz [not null]
  resolved_at timestamptz
  resolution_reason_code text
  version bigint [not null]
}

Table public.room_candle_events {
  id uuid [pk]
  room_id uuid [not null]
  count_before int [not null]
  count_after int [not null]
  physically_verified boolean [not null, default: false]
  reason_code text [not null]
  actor_profile_id uuid [not null]
  effective_at timestamptz [not null]
  recorded_at timestamptz [not null]
}

Table public.room_pin_sync_events {
  id uuid [pk]
  room_id uuid [not null]
  sync_status text [not null]
  pin_version bigint
  reason_code text [not null]
  actor_profile_id uuid [not null]
  effective_at timestamptz [not null]
  recorded_at timestamptz [not null]
}

Table public.room_pin_access_leases {
  id uuid [pk]
  room_id uuid [not null]
  reservation_id uuid
  cleaning_target_id uuid
  assignment_id uuid
  pin_version bigint [not null]
  issued_to uuid [not null]
  issued_at timestamptz [not null]
  expires_at timestamptz [not null]
  revealed_at timestamptz
  revoked_at timestamptz
  revoke_reason_code text
}

Table public.cleaning_template_versions {
  id uuid [pk]
  room_type_id uuid [not null]
  cleaning_kind cleaning_kind [not null]
  version int [not null]
  status text [not null]
  duration_minutes int [not null]
  published_at timestamptz
  created_by uuid [not null]
  created_at timestamptz [not null]

  Indexes {
    (room_type_id, cleaning_kind, version) [unique]
  }
}

Table public.cleaning_photo_slots {
  id uuid [pk]
  template_version_id uuid [not null]
  slot_key text [not null]
  section_key text [not null]
  label text [not null]
  description text
  display_order int [not null]
  required boolean [not null, default: true]

  Indexes {
    (template_version_id, slot_key) [unique]
    (template_version_id, display_order) [unique]
  }
}

Table public.cleaning_targets {
  id uuid [pk]
  room_id uuid [not null]
  reservation_id uuid
  checkout_obligation_id uuid [unique]
  cleaning_kind cleaning_kind [not null]
  source text [not null]
  source_key text [not null, unique]
  original_service_date date [not null]
  effective_service_date date [not null]
  carryover_count int [not null, default: 0]
  available_from timestamptz
  due_at timestamptz
  status cleaning_target_status [not null]
  assignment_version bigint [not null]
  room_type_snapshot jsonb [not null]
  fee_snapshot int [not null]
  template_snapshot jsonb [not null]
  cancelled_by uuid
  cancelled_at timestamptz
  cancellation_reason_code text
  reclean_of_attempt_id uuid [unique]
  reclean_maid_profile_id uuid
  created_by uuid [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  Note: 'Checkout targets are unique per reservation. Stayover/additional manual requests use stable target IDs and soft cancellation. Inspection recleans keep an immutable original attempt and maid link.'
}

Table public.cleaning_target_schedule_revisions {
  id uuid [pk]
  cleaning_target_id uuid [not null]
  revision bigint [not null]
  effective_service_date date [not null]
  available_from timestamptz
  due_at timestamptz
  reason_code text [not null]
  changed_by uuid [not null]
  recorded_at timestamptz [not null]

  Indexes {
    (cleaning_target_id, revision) [unique]
  }
}

Table public.cleaning_assignments {
  id uuid [pk]
  cleaning_target_id uuid [not null]
  maid_profile_id uuid [not null]
  sequence_number int [not null]
  revision bigint [not null]
  is_current boolean [not null, default: true]
  notified_at timestamptz
  ended_at timestamptz
  change_reason_code text
  changed_by uuid [not null]
  created_at timestamptz [not null]

  Indexes {
    (cleaning_target_id, revision) [unique]
  }

  Note: 'A partial unique index permits one current assignment per target.'
}

Table public.cleaning_attempts {
  id uuid [pk]
  cleaning_target_id uuid [not null]
  assignment_id uuid [not null]
  maid_profile_id uuid [not null]
  attempt_number int [not null]
  status attempt_status [not null]
  assignment_revision bigint [not null]
  started_at timestamptz
  field_completed_at timestamptz
  ended_at timestamptz
  end_reason text
  template_snapshot jsonb [not null]
  room_snapshot jsonb [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  Indexes {
    (cleaning_target_id, attempt_number) [unique]
  }
}

Table public.cleaning_submissions {
  id uuid [pk]
  cleaning_attempt_id uuid [not null]
  client_submission_id uuid [not null, unique]
  version int [not null]
  status submission_status [not null]
  issue_snapshot jsonb [not null]
  candle_count int [not null, default: 0]
  submitted_by uuid [not null]
  submitted_at timestamptz [not null]
  superseded_at timestamptz

  Indexes {
    (cleaning_attempt_id, version) [unique]
  }
}

Table public.submission_photos {
  id uuid [pk]
  submission_id uuid [not null]
  photo_slot_key text
  evidence_kind text [not null, note: 'template, bomb_room, issue']
  drive_file_id text [not null, unique]
  drive_folder_id text [not null]
  file_name text [not null]
  sha256 text [not null]
  mime_type text [not null]
  size_bytes int [not null]
  width_px int
  height_px int
  upload_status text [not null]
  captured_at timestamptz
  uploaded_at timestamptz [not null]
  purge_after timestamptz [not null, note: 'Always uploaded_at + 7 days']
  delete_attempt_count int [not null, default: 0]
  last_delete_error_code text
  purged_at timestamptz
  created_at timestamptz [not null]

  Indexes {
    submission_id
    purge_after
    (submission_id, photo_slot_key) [unique]
  }

  Note: 'The private object lives only in Google Drive. The backend enforces a 307200-byte limit and permanently deletes it 7 days after uploaded_at.'
}

Table public.bomb_room_reports {
  id uuid [pk]
  submission_id uuid [not null, unique]
  note text
  status text [not null]
  decision text
  decision_reason_code text
  decided_by uuid
  decided_at timestamptz
  created_at timestamptz [not null]
}

Table public.inspection_decisions {
  id uuid [pk]
  submission_id uuid [not null, unique]
  decision text [not null]
  reason_code text
  reason_detail text
  decided_by uuid [not null]
  decided_at timestamptz [not null]
}

Table public.earnings {
  id uuid [pk]
  earning_entitlement_id uuid [not null, unique]
  submission_id uuid [not null, unique]
  maid_profile_id uuid [not null]
  earned_on date [not null]
  base_amount int [not null]
  bomb_room_bonus int [not null, default: 0]
  total_amount int [not null, note: 'Generated as base_amount + bomb_room_bonus in SQL']
  created_at timestamptz [not null]
}

Table public.payroll_cycles {
  id uuid [pk]
  maid_profile_id uuid [not null]
  week_start date [not null]
  status payroll_status [not null]
  locked_amount int
  payment_started_by uuid
  payment_started_at timestamptz
  paid_at timestamptz
  check_reason text
  last_reopen_reason text
  last_reopened_by uuid [ref: > public.profiles.id]
  last_reopened_at timestamptz
  version bigint [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  Indexes {
    (maid_profile_id, week_start) [unique]
  }

  Note: 'Identity is immutable. Lock metadata is immutable after leaving OPEN except a reasoned, versioned PAYING/CHECK -> OPEN recovery. Candidate items remain; PAID snapshots are append-only.'
}

Table public.payroll_items {
  id uuid [pk]
  payroll_cycle_id uuid [not null]
  earning_id uuid [not null, unique]
  maid_profile_id uuid [not null]
  locked_amount int [not null]
  created_at timestamptz [not null]

  Indexes {
    (payroll_cycle_id, earning_id) [unique]
  }

  Note: 'Insert only while the cycle is OPEN. Earning earned_on must fall within the cycle week; membership and amount are immutable.'
}

Table public.payroll_events {
  id bigint [pk, increment]
  payroll_cycle_id uuid [not null]
  event_type text [not null]
  before_status payroll_status
  after_status payroll_status [not null]
  actor_profile_id uuid [not null]
  reason_code text
  created_at timestamptz [not null]
}

Table public.payroll_adjustments {
  id uuid [pk]
  payroll_cycle_id uuid [not null]
  amount int [not null]
  reason_code text [not null]
  created_by uuid [not null]
  created_at timestamptz [not null]
}

Table public.notifications {
  id uuid [pk]
  recipient_profile_id uuid [not null]
  category text [not null]
  title text [not null]
  body text [not null]
  room_id uuid
  cleaning_target_id uuid
  dedupe_key text
  group_key text
  requires_action boolean [not null, default: false]
  read_at timestamptz
  resolved_at timestamptz
  occurred_at timestamptz [not null]
  created_at timestamptz [not null]
}

Table private.notification_outbox {
  id bigint [pk, increment]
  notification_id uuid [not null]
  channel text [not null]
  delivery_status text [not null]
  retry_count int [not null, default: 0]
  next_attempt_at timestamptz
  delivered_at timestamptz
  last_error_code text
  created_at timestamptz [not null]
}

Table public.audit_events {
  id bigint [pk, increment]
  actor_profile_id uuid
  actor_display_name_snapshot text
  event_type text [not null]
  entity_type text [not null]
  entity_id uuid
  effective_at timestamptz [not null]
  recorded_at timestamptz [not null]
  reason_code text
  before_state jsonb
  after_state jsonb
  request_id text
  request_hash text
  idempotency_key text [unique]

  Note: 'UPDATE and DELETE are rejected by an append-only trigger.'
}

Ref: public.profiles.auth_user_id - auth.users.id
Ref: public.login_aliases.profile_id > public.profiles.id
Ref: public.maid_profiles.profile_id - public.profiles.id
Ref: public.availability_versions.maid_profile_id > public.profiles.id
Ref: public.availability_days.availability_version_id > public.availability_versions.id
Ref: public.availability_change_requests.availability_version_id > public.availability_versions.id
Ref: public.availability_change_requests.decided_by > public.profiles.id
