Ref: public.cleaning_target_schedule_revisions.cleaning_target_id > public.cleaning_targets.id
Ref: public.cleaning_target_schedule_revisions.changed_by > public.profiles.id
Ref: public.cleaning_assignments.cleaning_target_id > public.cleaning_targets.id
Ref: public.cleaning_assignments.maid_profile_id > public.profiles.id
Ref: public.cleaning_assignments.changed_by > public.profiles.id
Ref: public.cleaning_attempts.cleaning_target_id > public.cleaning_targets.id
Ref: public.cleaning_attempts.assignment_id > public.cleaning_assignments.id
Ref: public.cleaning_attempts.maid_profile_id > public.profiles.id
Ref: public.cleaning_submissions.cleaning_attempt_id > public.cleaning_attempts.id
Ref: public.cleaning_submissions.submitted_by > public.profiles.id
