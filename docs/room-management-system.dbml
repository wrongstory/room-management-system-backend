  active_endpoint_digest text
  active_session_digest text
  expiration_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  retired_at timestamptz
  indexes {
    active_endpoint_digest [unique, note: 'Partial active only; global endpoint capability ownership']
    (profile_id, active_session_digest) [unique, note: 'Partial active only; live session max one']
    (profile_id, status, updated_at, id)
    current_revision_id [note: 'Partial non-null current revision FK lookup']
  }
  Note: '#110 private logical/current projection. Profile active max five is transactionally enforced; raw Data API denied.'
}

Table private.web_push_subscription_revisions {
  id uuid [pk]
  subscription_id uuid [not null]
