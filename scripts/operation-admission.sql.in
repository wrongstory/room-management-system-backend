-- #396. Generated by scripts/generate-operation-admission-sql.mjs.
-- No seed/activation, TTL choice, reset, provider call or business authorization.
-- Receipt adapters are a finite allowlist; HTTP success is never terminal proof.
alter table private.developer_operation_admissions
  add column http_route_id text,
  add column http_actor_profile_id uuid,
  add column http_auth_user_id uuid,
  add column http_session_digest text,
  add column http_password_version text,
  add column http_command_name text,
  add column http_key_digest text,
  add column http_request_hash text,
  add constraint operation_http_identity_shape check (
    (http_route_id is null and http_actor_profile_id is null and http_auth_user_id is null
      and http_session_digest is null and http_password_version is null)
    or (http_route_id = 'AUTH_LOGIN' and http_actor_profile_id is null and http_auth_user_id is null
      and http_session_digest is null and http_password_version is null)
    or (http_route_id is not null and http_route_id <> 'AUTH_LOGIN' and http_actor_profile_id is not null
      and http_auth_user_id is not null and http_session_digest ~ '^[0-9a-f]{64}$'
      and http_session_digest is not null and http_password_version is not null)),
  add constraint operation_http_receipt_shape check (
    (http_command_name is null and http_key_digest is null and http_request_hash is null)
    or (http_route_id is not null and http_actor_profile_id is not null and http_command_name is not null
      and http_key_digest is not null and http_key_digest ~ '^[0-9a-f]{64}$'
      and http_request_hash is not null and http_request_hash ~ '^[0-9a-f]{64}$'));
-- No FK to profiles/Auth: evidence must survive a separately approved reset.
-- Bound the exact receipt lookup without retaining raw idempotency keys in the
-- admission. The existing actor/command/raw-key index cannot index this digest.
create index command_executions_operation_receipt_idx on private.command_executions
  (actor_profile_id,command_type,private.operation_secret_digest(idempotency_key),request_hash)
  include(completed_at);

create function private.operation_http_route(p_route text)
returns jsonb language sql immutable set search_path = pg_catalog as $$
  select jsonb_build_object('routeId', r.route_id, 'kind', r.kind, 'authority', r.authority,
    'hashMode', r.hash_mode, 'commandName', r.command_name, 'keyArgument', r.key_argument)
  from (values
@@HTTP_ROUTES@@
  ) r(route_id,kind,authority,hash_mode,command_name,key_argument) where r.route_id = p_route;
$$;

-- Admission authenticates the owner of an effect; it grants no attempt/action
-- capability. Original RPCs still validate role, ownership, revision and action.
create function private.assert_operation_http_identity(p_route jsonb,p_actor uuid,p_auth uuid,p_session text)
returns void language plpgsql volatile security definer set search_path = pg_catalog as $$
declare v_context jsonb; v_profile public.profiles;
begin
  if current_setting('transaction_isolation') <> 'read committed' or p_route is null then
    raise exception using errcode='42501',message='OPERATION_IDENTITY_REJECTED';
  end if;
  if p_route->>'authority' = 'LOGIN' then
    if p_route->>'routeId' <> 'AUTH_LOGIN' or p_actor is not null or p_auth is not null or p_session is not null then
      raise exception using errcode='42501',message='OPERATION_IDENTITY_REJECTED';
    end if;
    return;
  end if;
  if p_actor is null or p_auth is null or p_session is null
    or p_session !~* '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$' then
    raise exception using errcode='42501',message='OPERATION_IDENTITY_REJECTED';
  end if;
  if p_route->>'authority' = 'LIMITED_SESSION' then
    select * into v_profile from private.assert_attempt_actor_session_fresh(p_actor,p_session::uuid,false);
    if v_profile.auth_user_id is distinct from p_auth then
      raise exception using errcode='42501',message='OPERATION_IDENTITY_REJECTED';
    end if;
  elsif p_route->>'authority' = 'ACTIVE_SESSION' then
    v_context := public.get_active_auth_context(p_auth,p_session);
    if v_context->>'code' is distinct from 'OK' or v_context#>>'{profile,id}' is distinct from p_actor::text
      or (p_route->>'routeId' <> 'changePassword' and v_context#>>'{profile,must_change_password}' is distinct from 'false') then
      raise exception using errcode='42501',message='OPERATION_IDENTITY_REJECTED';
    end if;
  else
    raise exception using errcode='42501',message='OPERATION_IDENTITY_REJECTED';
  end if;
end;
$$;

-- Hash exactly the three existing SQL-owned availability payloads. This is not
-- an arbitrary JSON hash adapter. No raw args are retained in admission rows.
create function private.operation_availability_hash(p_route text,p_actor uuid,p_args jsonb)
returns text language plpgsql volatile set search_path = pg_catalog as $$
declare v_keys text[]; v_expected text[]; v_dates date[]; v_week date; v_version integer; v_payload jsonb;
begin
  if jsonb_typeof(p_args) is distinct from 'object' then
    raise exception using errcode='22023',message='OPERATION_COMMAND_BINDING_REJECTED';
  end if;
  v_expected := case p_route
    when 'submitAvailability' then array['p_actor_profile_id','p_available_dates','p_expected_version','p_week_start']
    when 'requestAvailabilityChange' then array['p_actor_profile_id','p_expected_version','p_reason_code','p_requested_available_dates','p_week_start']
    when 'decideAvailabilityChange' then array['p_actor_profile_id','p_change_request_id','p_decision','p_expected_version','p_reason_code']
    else null end;
  select array_agg(k order by k) into v_keys from jsonb_object_keys(p_args) k;
  if v_expected is null or v_keys is distinct from v_expected
    or jsonb_typeof(p_args->'p_actor_profile_id') is distinct from 'string'
    or (p_args->>'p_actor_profile_id')::uuid is distinct from p_actor
    or jsonb_typeof(p_args->'p_expected_version') is distinct from 'number'
    or p_args->>'p_expected_version' !~ '^[0-9]+$' then
    raise exception using errcode='22023',message='OPERATION_COMMAND_BINDING_REJECTED';
  end if;
  v_version := (p_args->>'p_expected_version')::integer;
  if p_route <> 'submitAvailability' and v_version < 1 then
    raise exception using errcode='22023',message='OPERATION_COMMAND_BINDING_REJECTED';
  end if;
  if p_route in ('submitAvailability','requestAvailabilityChange') then
    if jsonb_typeof(p_args->'p_week_start') is distinct from 'string'
      or p_args->>'p_week_start' !~ '^[0-9]{4}-[0-9]{2}-[0-9]{2}$' then
      raise exception using errcode='22023',message='OPERATION_COMMAND_BINDING_REJECTED';
    end if;
    v_week := (p_args->>'p_week_start')::date;
    v_payload := p_args->(case when p_route='submitAvailability' then 'p_available_dates' else 'p_requested_available_dates' end);
    if jsonb_typeof(v_payload) is distinct from 'array' then
      raise exception using errcode='22023',message='OPERATION_COMMAND_BINDING_REJECTED';
    end if;
    if exists(select 1 from jsonb_array_elements(v_payload) e
      where jsonb_typeof(e) is distinct from 'string' or e#>>'{}' !~ '^[0-9]{4}-[0-9]{2}-[0-9]{2}$') then
      raise exception using errcode='22023',message='OPERATION_COMMAND_BINDING_REJECTED';
    end if;
    select coalesce(array_agg(d::date),'{}'::date[]) into v_dates from jsonb_array_elements_text(v_payload) d;
    v_dates := private.assert_availability_dates(v_week,v_dates);
    if p_route='submitAvailability' then
      return private.availability_request_hash(jsonb_build_object('command','availability.submit',
        'actorProfileId',p_actor,'weekStart',v_week,'availableDates',to_jsonb(v_dates),'expectedVersion',v_version));
    end if;
  end if;
  if jsonb_typeof(p_args->'p_reason_code') is distinct from 'string'
    or p_args->>'p_reason_code' !~ '^[A-Z0-9_]{2,80}$' then
    raise exception using errcode='22023',message='OPERATION_COMMAND_BINDING_REJECTED';
  end if;
  if p_route='requestAvailabilityChange' then
    return private.availability_request_hash(jsonb_build_object('command','availability.change_requested',
      'actorProfileId',p_actor,'weekStart',v_week,'requestedAvailableDates',to_jsonb(v_dates),
      'reasonCode',p_args->>'p_reason_code','expectedVersion',v_version));
  end if;
  if jsonb_typeof(p_args->'p_change_request_id') is distinct from 'string'
    or jsonb_typeof(p_args->'p_decision') is distinct from 'string'
    or p_args->>'p_decision' not in ('approved','rejected') then
    raise exception using errcode='22023',message='OPERATION_COMMAND_BINDING_REJECTED';
  end if;
  return private.availability_request_hash(jsonb_build_object('command','availability.change_decided',
    'actorProfileId',p_actor,'changeRequestId',(p_args->>'p_change_request_id')::uuid,
    'decision',(p_args->>'p_decision')::public.availability_request_status,
    'reasonCode',p_args->>'p_reason_code','expectedVersion',v_version));
end;
$$;

create function public.get_operation_admission_control(p_target text)
returns jsonb language plpgsql volatile security definer set search_path = pg_catalog
set lock_timeout = '2s' set statement_timeout = '7s' as $$
declare v_control private.developer_operation_control;
begin
  if p_target is null or p_target !~ '^[a-z0-9][a-z0-9-]{2,63}$' then
    raise exception using errcode='22023',message='OPERATION_TARGET_INVALID';
  end if;
  select * into v_control from private.developer_operation_control where singleton;
  if not found then
    return jsonb_build_object('mode','INACTIVE','controlVersion',null,'targetRef',null);
  end if;
  return jsonb_build_object('mode',case when v_control.target_ref<>p_target or v_control.lifecycle='UNKNOWN'
      then 'UNKNOWN' else v_control.maintenance end,
    'controlVersion',v_control.version::text,'targetRef',v_control.target_ref);
end;
$$;

create function public.acquire_operation_http_admission(
  p_target text,p_version bigint,p_route_id text,p_actor uuid,p_auth uuid,p_session text,
  p_nonce text,p_deadline timestamptz,p_command_name text,p_idempotency_key text,p_request_hash text,
  p_command_args jsonb default null
) returns jsonb language plpgsql volatile security definer set search_path = pg_catalog
set lock_timeout = '2s' set statement_timeout = '7s' as $$
declare v_route jsonb; v_hash text; v_password text; v_owner text; v_id uuid;
begin
  v_route := private.operation_http_route(p_route_id);
  perform private.assert_operation_http_identity(v_route,p_actor,p_auth,p_session);
  if p_command_name is distinct from v_route->>'commandName' then
    raise exception using errcode='22023',message='OPERATION_COMMAND_BINDING_REJECTED';
  end if;
  if v_route->>'hashMode' = 'NONE' then
    if p_idempotency_key is not null or p_request_hash is not null or p_command_args is not null then
      raise exception using errcode='22023',message='OPERATION_COMMAND_BINDING_REJECTED';
    end if;
  else
    if p_idempotency_key is null or
      (case when v_route->>'keyArgument'='p_idempotency_key_digest'
        then p_idempotency_key !~ '^[0-9a-f]{64}$' else p_idempotency_key !~ '^[A-Za-z0-9._:-]{8,128}$' end) then
      raise exception using errcode='22023',message='OPERATION_COMMAND_BINDING_REJECTED';
    end if;
    if v_route->>'hashMode' = 'SQL_AVAILABILITY' then
      if p_request_hash is not null then
        raise exception using errcode='22023',message='OPERATION_COMMAND_BINDING_REJECTED';
      end if;
      v_hash := private.operation_availability_hash(p_route_id,p_actor,p_command_args);
    else
      if p_request_hash is null or p_request_hash !~ '^[0-9a-f]{64}$' or p_command_args is not null then
        raise exception using errcode='22023',message='OPERATION_COMMAND_BINDING_REJECTED';
      end if;
      v_hash := p_request_hash;
    end if;
  end if;
  v_password := case when p_auth is null then null else public.get_auth_password_version(p_auth) end;
  if p_auth is not null and v_password is null then
    raise exception using errcode='42501',message='OPERATION_IDENTITY_REJECTED';
  end if;
  v_owner := private.operation_secret_digest(jsonb_build_array(p_target,p_route_id,p_actor,p_auth,
    private.operation_secret_digest(p_session),v_password)::text);
  v_id := private.acquire_developer_operation_admission(p_target,p_version,v_route->>'kind',v_owner,p_nonce,p_deadline);
  update private.developer_operation_admissions set http_route_id=p_route_id,http_actor_profile_id=p_actor,
    http_auth_user_id=p_auth,http_session_digest=private.operation_secret_digest(p_session),
    http_password_version=v_password,http_command_name=p_command_name,
    http_key_digest=private.operation_secret_digest(p_idempotency_key),http_request_hash=v_hash where id=v_id;
  perform private.assert_operation_http_identity(v_route,p_actor,p_auth,p_session);
  if p_auth is not null and v_password is distinct from public.get_auth_password_version(p_auth) then
    raise exception using errcode='42501',message='OPERATION_IDENTITY_REJECTED';
  end if;
  return jsonb_build_object('admissionId',v_id,'controlVersion',p_version::text,
    'completionMode',case when p_command_name is null then 'OPAQUE' else 'COMMAND_RECEIPT' end);
end;
$$;

create function public.complete_operation_http_admission(
  p_admission_id uuid,p_nonce text,p_actor uuid,p_auth uuid,p_session text
) returns jsonb language plpgsql volatile security definer set search_path = pg_catalog
set lock_timeout = '2s' set statement_timeout = '7s' as $$
declare v_admission private.developer_operation_admissions; v_route jsonb;
begin
  select * into v_admission from private.developer_operation_admissions where id=p_admission_id for update;
  v_route := private.operation_http_route(v_admission.http_route_id);
  if v_admission.id is null or v_admission.completed_at is not null or v_admission.http_command_name is null
    or p_nonce is null or p_nonce !~ '^[0-9a-f]{64}$'
    or v_admission.nonce_hash is distinct from private.operation_secret_digest(p_nonce)
    or v_admission.http_actor_profile_id is distinct from p_actor or v_admission.http_auth_user_id is distinct from p_auth
    or v_admission.http_session_digest is distinct from private.operation_secret_digest(p_session)
    or v_admission.http_password_version is distinct from public.get_auth_password_version(p_auth) then
    raise exception using errcode='42501',message='OPERATION_COMPLETION_UNVERIFIED';
  end if;
  perform private.assert_operation_http_identity(v_route,p_actor,p_auth,p_session);
  -- Completed receipts are immutable and scoped by actor + command + key + hash.
  -- NULL entity_id is a valid no-op receipt (e.g. remittance); never require it.
  -- A replay may precede this admission, so do not require completed_at >= created_at.
  if not exists(select 1 from private.command_executions c
    where c.actor_profile_id=p_actor and c.command_type=v_admission.http_command_name
      and private.operation_secret_digest(c.idempotency_key)=v_admission.http_key_digest
      and c.request_hash=v_admission.http_request_hash and c.completed_at is not null) then
    raise exception using errcode='42501',message='OPERATION_COMPLETION_UNVERIFIED';
  end if;
  perform private.assert_operation_http_identity(v_route,p_actor,p_auth,p_session);
  if v_admission.http_password_version is distinct from public.get_auth_password_version(p_auth) then
    raise exception using errcode='42501',message='OPERATION_COMPLETION_UNVERIFIED';
  end if;
  perform private.complete_developer_operation_admission(p_admission_id,v_admission.owner_digest,p_nonce);
  return jsonb_build_object('completed',true);
end;
$$;

revoke all on function private.operation_http_route(text),
  private.assert_operation_http_identity(jsonb,uuid,uuid,text),
  private.operation_availability_hash(text,uuid,jsonb) from public,anon,authenticated,service_role;
revoke all on function public.get_operation_admission_control(text),
  public.acquire_operation_http_admission(text,bigint,text,uuid,uuid,text,text,timestamptz,text,text,text,jsonb),
  public.complete_operation_http_admission(uuid,text,uuid,uuid,text) from public,anon,authenticated;
grant execute on function public.get_operation_admission_control(text),
  public.acquire_operation_http_admission(text,bigint,text,uuid,uuid,text,text,timestamptz,text,text,text,jsonb),
  public.complete_operation_http_admission(uuid,text,uuid,uuid,text) to service_role;
