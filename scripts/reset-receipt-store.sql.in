-- #396 generated by scripts/generate-reset-receipt-store.mjs.
-- Durable observations only: no reset execution, policy, TTL default or activation.
create table private.developer_reset_receipt_heads (
  id uuid primary key default pg_catalog.gen_random_uuid(),
  actor_profile_id uuid not null,
  project_ref text not null check (project_ref ~ '^[a-z]{20}$'),
  key_digest text not null check (key_digest ~ '^[a-f0-9]{64}$'),
  binding jsonb not null,
  header jsonb not null,
  version integer not null check (version between 0 and 1000),
  head_hash text not null check (head_hash ~ '^[a-f0-9]{64}$'),
  unique(actor_profile_id,project_ref,key_digest)
);
create table private.developer_reset_receipt_events (
  receipt_id uuid not null references private.developer_reset_receipt_heads(id),
  sequence integer not null check (sequence between 1 and 1000),
  entry jsonb not null,
  primary key(receipt_id,sequence)
);
-- No Auth/profile FK: approved business cleanup must not erase this journal.
alter table private.developer_reset_receipt_heads enable row level security;
alter table private.developer_reset_receipt_heads force row level security;
alter table private.developer_reset_receipt_events enable row level security;
alter table private.developer_reset_receipt_events force row level security;
revoke all on private.developer_reset_receipt_heads,private.developer_reset_receipt_events from public,anon,authenticated,service_role;

-- Only ASCII field names and hash/UUID/enum strings are admitted below. Thus this
-- canonical encoding matches requestHash's sorted JSON for the finite contract.
create function private.reset_receipt_canonical(p_value jsonb)
returns text language plpgsql immutable strict set search_path=pg_catalog as $$
declare result text;
begin
  case jsonb_typeof(p_value)
    when 'object' then
      select '{'||coalesce(string_agg(to_jsonb(key)::text||':'||private.reset_receipt_canonical(value),',' order by key collate "C"),'')||'}'
      into result from jsonb_each(p_value);
    when 'array' then
      select '['||coalesce(string_agg(private.reset_receipt_canonical(value),',' order by ord),'')||']'
      into result from jsonb_array_elements(p_value) with ordinality a(value,ord);
    else result := p_value::text;
  end case;
  return result;
end $$;
create function private.reset_receipt_hash(p_value jsonb)
returns text language sql immutable strict set search_path=pg_catalog as $$
  select encode(extensions.digest(private.reset_receipt_canonical(p_value),'sha256'),'hex')
$$;
create function private.reset_receipt_fields(p_value jsonb,p_names text[])
returns boolean language sql immutable set search_path=pg_catalog as $$
  select coalesce(jsonb_typeof(p_value)='object' and p_value ?& p_names
    and (p_value - p_names)='{}'::jsonb,false)
$$;

create function private.validate_reset_receipt(p_binding jsonb,p_header jsonb,p_entries jsonb,p_now bigint)
returns void language plpgsql immutable set search_path=pg_catalog as $$
declare k text; s jsonb; e jsonb; row_value jsonb; state jsonb := '{}'::jsonb;
  previous_hash text; last_at bigint; expires bigint; seq integer := 0; next_step text; final boolean := false;
begin
  if p_now is null or p_now<0 or p_now>8640000000000000
    or octet_length(coalesce(p_binding::text,''))>4096 or octet_length(coalesce(p_header::text,''))>32768
    or octet_length(coalesce(p_entries::text,''))>1048576
    or not private.reset_receipt_fields(p_binding,array['actorProfileId','authUserId','sessionDigest','passwordVersionDigest',
      'projectRef','sourceCommit','catalogFingerprint','contentFingerprint','planFingerprint','expectedPostconditionFingerprint',
      'policyHash','approvalScopeHash','backupProofHash'])
    or not private.reset_receipt_fields(p_header,array['format','commandHash','bindingHash','idempotencyKeyDigest',
      'expectedPostconditionFingerprint','createdAt','expiresAt','steps']) then
    raise exception using errcode='22023',message='RESET_RECEIPT_INPUT_INVALID';
  end if;
  for k in select jsonb_object_keys(p_binding) loop
    if jsonb_typeof(p_binding->k) is distinct from 'string' or (case
      when k in ('actorProfileId','authUserId') then p_binding->>k ~ '^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$'
      when k='projectRef' then p_binding->>k ~ '^[a-z]{20}$'
      when k='sourceCommit' then p_binding->>k ~ '^[a-f0-9]{40}$'
      else p_binding->>k ~ '^[a-f0-9]{64}$' end) is not true then
      raise exception using errcode='22023',message='RESET_RECEIPT_INPUT_INVALID';
    end if;
  end loop;
  if p_header->>'format' is distinct from 'reset-receipt-v1'
    or jsonb_typeof(p_header->'createdAt') is distinct from 'number' or (p_header->>'createdAt' ~ '^(0|[1-9][0-9]{0,15})$') is not true
    or jsonb_typeof(p_header->'expiresAt') is distinct from 'number' or (p_header->>'expiresAt' ~ '^(0|[1-9][0-9]{0,15})$') is not true
    or jsonb_typeof(p_header->'steps') is distinct from 'array' or jsonb_typeof(p_entries) is distinct from 'array' then
    raise exception using errcode='22023',message='RESET_RECEIPT_INPUT_INVALID';
  end if;
  last_at := (p_header->>'createdAt')::bigint; expires := (p_header->>'expiresAt')::bigint;
  if last_at>p_now or expires<=last_at or expires>8640000000000000
    or jsonb_array_length(p_header->'steps') not between 1 and 100 or jsonb_array_length(p_entries)>1000 then
    raise exception using errcode='22023',message='RESET_RECEIPT_INPUT_INVALID';
  end if;
  foreach k in array array['commandHash','bindingHash','idempotencyKeyDigest','expectedPostconditionFingerprint'] loop
    if jsonb_typeof(p_header->k) is distinct from 'string' or (p_header->>k ~ '^[a-f0-9]{64}$') is not true then
      raise exception using errcode='22023',message='RESET_RECEIPT_INPUT_INVALID';
    end if;
  end loop;
  if p_header->>'bindingHash' is distinct from private.reset_receipt_hash(p_binding)
    or p_header->>'expectedPostconditionFingerprint' is distinct from p_binding->>'expectedPostconditionFingerprint'
    or p_header->>'commandHash' is distinct from private.reset_receipt_hash(p_header-array['format','commandHash']) then
    raise exception using errcode='22023',message='RESET_RECEIPT_BINDING_CHANGED';
  end if;
  for s in select value from jsonb_array_elements(p_header->'steps') loop
    if not private.reset_receipt_fields(s,array['id','kind']) or jsonb_typeof(s->'id') is distinct from 'string'
      or (s->>'id' ~ '^[a-f0-9]{64}$') is not true or (s->>'kind' in ('DATABASE','AUTH','EXTERNAL')) is not true
      or state ? (s->>'id') then
      raise exception using errcode='22023',message='RESET_RECEIPT_INPUT_INVALID';
    end if;
    state := state||jsonb_build_object(s->>'id','PENDING');
  end loop;
  previous_hash := private.reset_receipt_hash(p_header);
  for row_value in select value from jsonb_array_elements(p_entries) loop
    seq := seq+1;
    if not private.reset_receipt_fields(row_value,array['sequence','at','previousHash','event','hash'])
      or jsonb_typeof(row_value->'sequence') is distinct from 'number' or row_value->>'sequence' is distinct from seq::text
      or jsonb_typeof(row_value->'at') is distinct from 'number' or (row_value->>'at' ~ '^(0|[1-9][0-9]{0,15})$') is not true
      or jsonb_typeof(row_value->'previousHash') is distinct from 'string' or jsonb_typeof(row_value->'hash') is distinct from 'string'
      or row_value->>'previousHash' is distinct from previous_hash
      or row_value->>'hash' is distinct from private.reset_receipt_hash(row_value-'hash') or final then
      raise exception using errcode='22023',message='RESET_RECEIPT_CHAIN_INVALID';
    end if;
    if (row_value->>'at')::bigint<last_at or (row_value->>'at')::bigint>p_now then
      raise exception using errcode='22023',message='RESET_RECEIPT_TIME_INVALID';
    end if;
    last_at := (row_value->>'at')::bigint; e := row_value->'event';
    if e->>'type'='STARTED' then
      select value->>'id' into next_step from jsonb_array_elements(p_header->'steps') with ordinality a(value,ord)
        where state->>(value->>'id')<>'APPLIED' order by ord limit 1;
      if not private.reset_receipt_fields(e,array['type','stepId','bindingHash']) or e->>'stepId' is distinct from next_step
        or jsonb_typeof(e->'stepId') is distinct from 'string' or jsonb_typeof(e->'bindingHash') is distinct from 'string'
        or state->>(e->>'stepId') is distinct from 'PENDING' or last_at>=expires
        or e->>'bindingHash' is distinct from p_header->>'bindingHash' then
        raise exception using errcode='22023',message='RESET_RECEIPT_STEP_REJECTED';
      end if;
      state := state||jsonb_build_object(e->>'stepId','STARTED');
    elsif e->>'type'='OBSERVED' then
      if not private.reset_receipt_fields(e,array['type','stepId','outcome','evidenceHash'])
        or jsonb_typeof(e->'stepId') is distinct from 'string'
        or (state->>(e->>'stepId') in ('STARTED','UNKNOWN')) is not true
        or (e->>'outcome' in ('APPLIED','NOT_APPLIED','UNKNOWN')) is not true
        or (case when e->>'outcome'='UNKNOWN' then e->'evidenceHash'='null'::jsonb
          else jsonb_typeof(e->'evidenceHash')='string' and e->>'evidenceHash' ~ '^[a-f0-9]{64}$' end) is not true then
        raise exception using errcode='22023',message='RESET_RECEIPT_OBSERVATION_REJECTED';
      end if;
      state := state||jsonb_build_object(e->>'stepId',e->>'outcome');
    elsif e->>'type'='FINAL_VERIFIED' then
      if not private.reset_receipt_fields(e,array['type','postconditionFingerprint','evidenceHash','remoteQuiescent'])
        or exists(select 1 from jsonb_each_text(state) where value<>'APPLIED')
        or e->>'postconditionFingerprint' is distinct from p_header->>'expectedPostconditionFingerprint'
        or jsonb_typeof(e->'postconditionFingerprint') is distinct from 'string'
        or jsonb_typeof(e->'evidenceHash') is distinct from 'string' or (e->>'evidenceHash' ~ '^[a-f0-9]{64}$') is not true
        or e->'remoteQuiescent' is distinct from 'true'::jsonb then
        raise exception using errcode='22023',message='RESET_RECEIPT_FINAL_REJECTED';
      end if;
      final := true;
    else raise exception using errcode='22023',message='RESET_RECEIPT_INPUT_INVALID';
    end if;
    previous_hash := row_value->>'hash';
  end loop;
end $$;

create function private.protect_reset_receipt_history()
returns trigger language plpgsql set search_path=pg_catalog as $$
begin
  if TG_OP='UPDATE' and TG_TABLE_NAME='developer_reset_receipt_heads' then
    if (to_jsonb(new)-array['version','head_hash']) is distinct from (to_jsonb(old)-array['version','head_hash'])
      or new.version<>old.version+1 or not exists(select 1 from private.developer_reset_receipt_events e
        where e.receipt_id=old.id and e.sequence=new.version and e.entry->>'previousHash'=old.head_hash and e.entry->>'hash'=new.head_hash) then
      raise exception using errcode='42501',message='RESET_RECEIPT_HEAD_REJECTED';
    end if;
    return new;
  end if;
  raise exception using errcode='42501',message='RESET_RECEIPT_IMMUTABLE';
end $$;
create trigger protect_reset_receipt_head before update or delete on private.developer_reset_receipt_heads
for each row execute function private.protect_reset_receipt_history();
create trigger protect_reset_receipt_events before update or delete on private.developer_reset_receipt_events
for each row execute function private.protect_reset_receipt_history();
create trigger protect_reset_receipt_head_truncate before truncate on private.developer_reset_receipt_heads
for each statement execute function private.protect_reset_receipt_history();
create trigger protect_reset_receipt_events_truncate before truncate on private.developer_reset_receipt_events
for each statement execute function private.protect_reset_receipt_history();

create function private.assert_reset_receipt_identity(p_actor uuid,p_auth uuid,p_session text,p_binding jsonb)
returns void language plpgsql volatile security definer set search_path=pg_catalog as $$
begin
  if current_setting('transaction_isolation')<>'read committed' or p_session is null
    or p_session !~ '^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$' then
    raise exception using errcode='42501',message='RESET_RECEIPT_IDENTITY_REJECTED';
  end if;
  perform private.assert_developer_operation_actor(p_actor,p_auth,p_session);
  if p_binding->>'actorProfileId' is distinct from p_actor::text or p_binding->>'authUserId' is distinct from p_auth::text
    or p_binding->>'sessionDigest' is distinct from private.operation_secret_digest(p_session)
    or p_binding->>'passwordVersionDigest' is distinct from private.operation_secret_digest(public.get_auth_password_version(p_auth))
    or exists(select 1 from private.developer_operation_control where target_ref<>p_binding->>'projectRef') then
    raise exception using errcode='42501',message='RESET_RECEIPT_IDENTITY_REJECTED';
  end if;
end $$;

create function public.store_developer_reset_receipt(p_mode text,p_actor uuid,p_auth uuid,p_session text,
  p_binding jsonb,p_header jsonb,p_expected_version integer,p_expected_head text,p_entry jsonb)
returns jsonb language plpgsql volatile security definer set search_path=pg_catalog
set lock_timeout='2s' set statement_timeout='7s' as $$
declare r private.developer_reset_receipt_heads; events jsonb; result jsonb; actual_head text; n integer;
  now_ms bigint; deadline timestamptz:=clock_timestamp()+interval '5 seconds';
begin
  perform private.assert_reset_receipt_identity(p_actor,p_auth,p_session,p_binding);
  now_ms := floor(extract(epoch from clock_timestamp())*1000)::bigint;
  perform private.validate_reset_receipt(p_binding,p_header,'[]'::jsonb,now_ms);
  if (p_mode in ('CREATE','READ','APPEND')) is not true or p_expected_version is null
    or p_expected_version not between 0 and 1000 or p_expected_head is null or p_expected_head !~ '^[a-f0-9]{64}$'
    or (p_mode<>'APPEND' and p_entry is not null) or (p_mode='APPEND' and p_entry is null)
    or octet_length(coalesce(p_entry::text,''))>2048 then
    raise exception using errcode='22023',message='RESET_RECEIPT_INPUT_INVALID';
  end if;
  if p_mode='CREATE' then
    if p_expected_version<>0 or p_expected_head<>private.reset_receipt_hash(p_header) then
      raise exception using errcode='22023',message='RESET_RECEIPT_STALE_VERSION';
    end if;
    insert into private.developer_reset_receipt_heads(actor_profile_id,project_ref,key_digest,binding,header,version,head_hash)
      values(p_actor,p_binding->>'projectRef',p_header->>'idempotencyKeyDigest',p_binding,p_header,0,p_expected_head)
      on conflict(actor_profile_id,project_ref,key_digest) do nothing;
  end if;
  select * into r from private.developer_reset_receipt_heads where actor_profile_id=p_actor
    and project_ref=p_binding->>'projectRef' and key_digest=p_header->>'idempotencyKeyDigest' for update;
  if not found or r.binding is distinct from p_binding or r.header is distinct from p_header then
    raise exception using errcode='22023',message='RESET_RECEIPT_COMMAND_CHANGED';
  end if;
  select coalesce(jsonb_agg(entry order by sequence),'[]'::jsonb),count(*) into events,n
    from private.developer_reset_receipt_events where receipt_id=r.id;
  actual_head := case when n=0 then private.reset_receipt_hash(r.header) else events->(n-1)->>'hash' end;
  if n<>r.version or actual_head is distinct from r.head_hash then
    raise exception using errcode='22023',message='RESET_RECEIPT_HEAD_INCONSISTENT';
  end if;
  perform private.validate_reset_receipt(r.binding,r.header,events,now_ms);
  if p_expected_version>r.version or p_expected_head is distinct from
    (case when p_expected_version=0 then private.reset_receipt_hash(r.header) else events->(p_expected_version-1)->>'hash' end) then
    raise exception using errcode='22023',message='RESET_RECEIPT_PREFIX_ROLLBACK';
  end if;
  if p_mode='APPEND' then
    if r.version<>p_expected_version or r.head_hash<>p_expected_head or r.version>=1000 then
      raise exception using errcode='40001',message='RESET_RECEIPT_STALE_VERSION';
    end if;
    events := events||jsonb_build_array(p_entry);
    perform private.validate_reset_receipt(r.binding,r.header,events,now_ms);
    insert into private.developer_reset_receipt_events(receipt_id,sequence,entry) values(r.id,r.version+1,p_entry);
    update private.developer_reset_receipt_heads set version=version+1,head_hash=p_entry->>'hash'
      where id=r.id and version=p_expected_version and head_hash=p_expected_head returning * into r;
    if not found then raise exception using errcode='40001',message='RESET_RECEIPT_STALE_VERSION'; end if;
  end if;
  -- Fresh SQL readback, not a returned echo of p_entry. Head lock prevents interleaved append.
  select coalesce(jsonb_agg(entry order by sequence),'[]'::jsonb),count(*) into events,n
    from private.developer_reset_receipt_events where receipt_id=r.id;
  actual_head := case when n=0 then private.reset_receipt_hash(r.header) else events->(n-1)->>'hash' end;
  if n<>r.version or actual_head is distinct from r.head_hash then
    raise exception using errcode='22023',message='RESET_RECEIPT_HEAD_INCONSISTENT';
  end if;
  perform private.assert_reset_receipt_identity(p_actor,p_auth,p_session,p_binding);
  if clock_timestamp()>=deadline then raise exception using errcode='57014',message='RESET_RECEIPT_TIMEOUT'; end if;
  result := jsonb_build_object('format','reset-receipt-store-v1','receipt',r.header||jsonb_build_object('events',events),
    'anchor',jsonb_build_object('commandHash',r.header->>'commandHash','version',r.version,'headHash',r.head_hash),'executionEnabled',false);
  return result;
end $$;

alter function private.reset_receipt_canonical(jsonb) owner to postgres;
alter function private.reset_receipt_hash(jsonb) owner to postgres;
alter function private.reset_receipt_fields(jsonb,text[]) owner to postgres;
alter function private.validate_reset_receipt(jsonb,jsonb,jsonb,bigint) owner to postgres;
alter function private.protect_reset_receipt_history() owner to postgres;
alter function private.assert_reset_receipt_identity(uuid,uuid,text,jsonb) owner to postgres;
alter function public.store_developer_reset_receipt(text,uuid,uuid,text,jsonb,jsonb,integer,text,jsonb) owner to postgres;
revoke all on function private.reset_receipt_canonical(jsonb),private.reset_receipt_hash(jsonb),private.reset_receipt_fields(jsonb,text[]),
  private.validate_reset_receipt(jsonb,jsonb,jsonb,bigint),private.protect_reset_receipt_history(),
  private.assert_reset_receipt_identity(uuid,uuid,text,jsonb) from public,anon,authenticated,service_role;
revoke all on function public.store_developer_reset_receipt(text,uuid,uuid,text,jsonb,jsonb,integer,text,jsonb) from public,anon,authenticated,service_role;
grant execute on function public.store_developer_reset_receipt(text,uuid,uuid,text,jsonb,jsonb,integer,text,jsonb) to service_role;

-- Append-only classification extension. Sources127/128 stay byte-for-byte frozen.
-- Inventory and combined129 collector remain unchanged and still share one snapshot.
@@COLLECTOR_EXTENSION@@
