{
  "name": "room-management-system-backend",
  "version": "0.1.0",
  "private": true,
  "description": "CASTLE THE ART 객실관리 백엔드 API",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "bootstrap:admin": "tsx src/scripts/bootstrap-admin.ts",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "secrets:check": "node scripts/check-secrets.mjs",
    "ci:quality": "npm run secrets:check && npm run lint && npm run typecheck && npm test && npm run build",
    "supabase": "supabase",
    "db:new": "supabase migration new",
    "db:start": "supabase start",
    "db:start:ci": "supabase start --exclude studio,imgproxy,storage-api,realtime,edge-runtime,logflare,vector,supavisor",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:verify": "supabase db reset --local --no-seed",
    "db:test": "supabase test db supabase/tests --local",
    "db:test:concurrency": "node scripts/test-reservation-concurrency.mjs",
    "edge:check": "node scripts/check-edge-functions.mjs"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@supabase/supabase-js": "2.112.4",
    "dotenv": "17.2.3",
    "fastify": "5.12.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@types/node": "24.10.2",
    "supabase": "2.115.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
