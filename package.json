{
  "name": "room-management-system-backend",
  "version": "0.1.0",
  "private": true,
  "description": "CASTLE THE ART 객실관리 백엔드 API",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "bootstrap:admin": "tsx src/scripts/bootstrap-admin.ts",
    "bootstrap:developer": "tsx src/scripts/bootstrap-admin.ts",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "secrets:check": "node scripts/check-secrets.mjs",
    "ci:quality": "npm run secrets:check && npm run openapi:frontend:check && npm run lint && npm run typecheck && npm test && npm run build",
    "supabase": "supabase",
    "db:new": "supabase migration new",
    "db:start": "supabase start",
    "db:start:ci": "supabase start --exclude studio,imgproxy,storage-api,realtime,edge-runtime,logflare,vector,supavisor",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:verify": "supabase db reset --local --no-seed",
    "db:manifest:generate": "node scripts/generate-migration-manifest-dev.mjs",
    "db:manifest:generate:v0.5.0": "node scripts/generate-migration-manifest.mjs",
    "db:manifest:verify": "node scripts/verify-migration-manifest.mjs && node scripts/verify-migration-manifest-v0.5.1.mjs && node scripts/verify-migration-manifest-dev.mjs",
    "db:test": "node scripts/test-production-v56-upgrade.mjs && node scripts/test-production-v73-upgrade.mjs && node scripts/test-payroll-payment-upgrade.mjs && node scripts/test-room-pin-nonce-upgrade.mjs && node scripts/test-checkout-incident-upgrade.mjs && node scripts/test-cleaning-template-duration-upgrade.mjs && node scripts/test-reservation-during-stay-upgrade.mjs && node scripts/test-photo-retention-upgrade.mjs && node scripts/test-room-pin-entitlement-upgrade.mjs && node scripts/test-reservation-long-stay-upgrade.mjs && node scripts/test-reservation-bookability-upgrade.mjs && supabase test db supabase/tests --local",
    "db:test:concurrency": "node scripts/test-reservation-concurrency.mjs",
    "backup:dry-run": "node scripts/backup-recovery-dry-run.mjs --target local-synthetic",
    "backup:dry-run:fresh": "npm run db:verify && npm run backup:dry-run",
    "edge:check": "node scripts/check-edge-functions.mjs",
    "swagger:pages:build": "node scripts/build-swagger-pages.mjs",
    "console:openapi:export": "tsx scripts/export-backend-console-openapi.ts",
    "openapi:export:full": "tsx scripts/export-full-openapi.ts",
    "openapi:frontend:check": "tsx scripts/check-frontend-openapi-contract.mjs"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@imagemagick/magick-wasm": "0.0.43",
    "@supabase/supabase-js": "2.112.4",
    "dotenv": "17.2.3",
    "fastify": "5.12.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@types/node": "24.10.2",
    "supabase": "2.115.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
