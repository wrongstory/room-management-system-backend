CORS_ORIGINS=http://127.0.0.1:4173,http://localhost:4173
# production | recovery | local. 운영도구가 연결 대상을 텍스트로 확인할 때 사용합니다.
RUNTIME_ENVIRONMENT=local
# 32자 이상의 별도 무작위 값. production에서는 Function Secret과 Vault에만 같은 값을 저장합니다.
SCHEDULER_INVOKE_SECRET=replace_with_at_least_32_random_characters
RESERVATION_SCHEDULER_ACTOR_PROFILE_ID=00000000-0000-4000-8000-000000000000
PAYROLL_CURSOR_HMAC_SECRET=replace_with_a_distinct_32_byte_random_secret
NOTIFICATION_CURSOR_HMAC_SECRET=replace_with_another_distinct_32_byte_secret
WEB_PUSH_SUBSCRIPTION_KEY_BASE64=
WEB_PUSH_SUBSCRIPTION_KEY_VERSION=
WEB_PUSH_SUBSCRIPTION_KEYRING_JSON=
WEB_PUSH_BINDING_DIGEST_SECRET=
VAPID_SUBJECT=
VAPID_CURRENT_KEY_VERSION=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_KEYRING_JSON=
NOTIFICATION_DELIVERY_INVOKE_SECRET=
