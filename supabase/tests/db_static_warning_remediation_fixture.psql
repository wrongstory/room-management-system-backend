-- Projection-only synthetic graph for #363. No command or retention policy is
-- inferred from these rows; the owning pgTAP transaction always rolls it back.
create function pg_temp.warning_id(n integer) returns uuid language sql immutable as $$
  select ('f3630000-0000-4000-8000-' || lpad(n::text, 12, '0'))::uuid
$$;
create temp table warning_clock as
select statement_timestamp() as at_time,
  (statement_timestamp() at time zone 'Asia/Seoul')::date as service_date;
-- The invoker wrapper exercises the actual service role without SECURITY
-- DEFINER test scaffolding. Only this transaction-local clock is readable.
grant select on warning_clock to service_role;

insert into auth.users(id) select pg_temp.warning_id(100+n) from generate_series(1,8)n;
select public.bootstrap_first_developer_profile(
  pg_temp.warning_id(1), pg_temp.warning_id(101), 'warning developer', 'warning developer',
  '0363', repeat('d',64), 'warning-remediation-bootstrap'
);

-- Replica mode is limited to synthesis. It bypasses immutable workflow triggers,
-- while CHECK/NOT NULL/UNIQUE constraints remain effective.
set local session_replication_role = replica;
insert into public.profiles(id,auth_user_id,display_name,display_name_normalized,
  login_id,login_id_normalized,login_sequence,role,status,must_change_password)
select pg_temp.warning_id(n),pg_temp.warning_id(100+n),'warning-'||n,'warning-'||n,
  'warning-'||n,'warning-'||n,0,
  case when n=2 then 'admin' else 'maid' end::public.app_role,
  case n when 5 then 'inactive' when 6 then 'upload_only'
    when 7 then 'deactivation_pending' else 'active' end::public.account_status,
  n=8
from generate_series(2,8)n;
insert into auth.sessions(id,user_id,not_after)
select pg_temp.warning_id(200+n),pg_temp.warning_id(100+n),null
from generate_series(1,8)n;
insert into auth.sessions(id,user_id,not_after) values
  (pg_temp.warning_id(302),pg_temp.warning_id(102),statement_timestamp()+interval '1 day'),
  (pg_temp.warning_id(402),pg_temp.warning_id(102),statement_timestamp()-interval '1 day');

insert into public.cleaning_targets(id,room_id,cleaning_kind,source,source_key,
  original_service_date,effective_service_date,available_from,status,assignment_version,
  room_type_snapshot,fee_snapshot,template_snapshot,created_by)
select pg_temp.warning_id(700+n),r.id,'additional','manual_room_request','warning-target-'||n,
  c.service_date,c.service_date,c.at_time-interval '2 hours','approved',1,
  jsonb_build_object('code','standard','name','immutable warning type'),10000,'{}',pg_temp.warning_id(2)
from generate_series(1,2)n cross join warning_clock c
cross join (select id from public.rooms order by room_number limit 1)r;
insert into public.cleaning_assignments(id,cleaning_target_id,maid_profile_id,sequence_number,
  revision,is_current,notified_at,changed_by,service_date,notified_room_id_snapshot,
  notified_room_number_snapshot)
select pg_temp.warning_id(800+n),pg_temp.warning_id(700+n),pg_temp.warning_id(3),n,
  1,true,c.at_time-interval '2 hours',pg_temp.warning_id(2),c.service_date,r.id,r.room_number
from generate_series(1,2)n cross join warning_clock c
cross join (select id,room_number from public.rooms order by room_number limit 1)r;
insert into public.cleaning_attempts(id,cleaning_target_id,assignment_id,maid_profile_id,
  attempt_number,status,assignment_revision,started_at,field_completed_at,ended_at,
  template_snapshot,room_snapshot)
select pg_temp.warning_id(900+n),pg_temp.warning_id(700+n),pg_temp.warning_id(800+n),
  pg_temp.warning_id(3),1,'field_completed',1,c.at_time-interval '30 minutes',
  c.at_time,c.at_time,'{}',jsonb_build_object('roomId',r.id,'roomNumber','snapshot-363',
    'code','standard','name','immutable warning type')
from generate_series(1,2)n cross join warning_clock c
cross join (select id from public.rooms order by room_number limit 1)r;
insert into public.cleaning_submissions(id,cleaning_attempt_id,client_submission_id,
  version,status,photo_manifest,submitted_by,submitted_at)
select pg_temp.warning_id(1000+n),pg_temp.warning_id(900+n),pg_temp.warning_id(1050+n),
  1,'submitted','{}',pg_temp.warning_id(3),c.at_time
from generate_series(1,2)n cross join warning_clock c;
insert into private.target_photo_snapshot_contracts(cleaning_target_id,ready,frozen_snapshot)
select pg_temp.warning_id(700+n),false,'{}' from generate_series(1,2)n;
insert into private.target_photo_slot_snapshots(id,cleaning_target_id,template_version_id,
  slot_key,display_order,required,slot_snapshot)
select pg_temp.warning_id(1100+n),pg_temp.warning_id(700+n),pg_temp.warning_id(600),
  'proof',0,true,jsonb_build_object('label','synthetic warning proof')
from generate_series(1,2)n;
insert into private.attempt_photo_versions(id,cleaning_attempt_id,cleaning_target_id,
  target_photo_slot_id,version,validation_status,sha256,mime_type,size_bytes,uploaded_at,purge_after)
select pg_temp.warning_id(1200+n),pg_temp.warning_id(900+n),pg_temp.warning_id(700+n),
  pg_temp.warning_id(1100+n),1,'verified',repeat('a',64),'image/jpeg',100,
  c.at_time-interval '167 hours',c.at_time+interval '1 hour'
from generate_series(1,2)n cross join warning_clock c;
insert into private.submission_photo_bindings(submission_id,cleaning_attempt_id,
  cleaning_target_id,target_photo_slot_id,photo_version_id,photo_version)
select pg_temp.warning_id(1000+n),pg_temp.warning_id(900+n),pg_temp.warning_id(700+n),
  pg_temp.warning_id(1100+n),pg_temp.warning_id(1200+n),1 from generate_series(1,2)n;
insert into private.submission_photo_binding_sets(submission_id,cleaning_attempt_id,photo_count,sealed_at)
select pg_temp.warning_id(1000+n),pg_temp.warning_id(900+n),1,c.at_time
from generate_series(1,2)n cross join warning_clock c;
insert into private.submission_current_pointers(cleaning_attempt_id,submission_id,revision)
select pg_temp.warning_id(900+n),pg_temp.warning_id(1000+n),1 from generate_series(1,2)n;

-- The second photo has retention-v2 metadata with meaningful NULL expiry. The
-- first deliberately has no provider acceptance/retention row and is legacy.
insert into private.photo_upload_operations(id,actor_profile_id,idempotency_key_digest,
  request_hash,cleaning_attempt_id,cleaning_target_id,assignment_id,assignment_revision,
  target_photo_slot_id,expected_photo_revision,sha256,mime_type,size_bytes)
values(pg_temp.warning_id(1302),pg_temp.warning_id(3),repeat('b',64),repeat('c',64),
  pg_temp.warning_id(902),pg_temp.warning_id(702),pg_temp.warning_id(802),1,
  pg_temp.warning_id(1102),0,repeat('a',64),'image/jpeg',100);
insert into private.photo_provider_objects(id,operation_id,provider_locator,uploaded_at,purge_after)
select pg_temp.warning_id(1402),pg_temp.warning_id(1302),'warning-object-363',
  c.at_time-interval '167 hours',c.at_time+interval '1 hour' from warning_clock c;
insert into private.photo_upload_acceptances(operation_id,object_id,photo_version_id,accepted_at)
select pg_temp.warning_id(1302),pg_temp.warning_id(1402),pg_temp.warning_id(1202),c.at_time
from warning_clock c;
insert into private.photo_retention_records(object_id,operation_id,photo_version_id,
  performer_maid_profile_id,effective_policy_kind,retention_starts_at,expires_at,purged_at,media_availability)
values(pg_temp.warning_id(1402),pg_temp.warning_id(1302),pg_temp.warning_id(1202),
  pg_temp.warning_id(3),'cleaning_submission',null,null,null,'available');
set local session_replication_role = origin;
