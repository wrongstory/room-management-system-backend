-- #535 operator-only, session-local repair helper. Defining it does not repair any row.
-- Before invoking: explicit approval, verified missing-marker incident, block password
-- change/reset traffic for the target and drain all old API executions for >=15 minutes.
-- This cutoff is operator evidence, not a replacement for the operational drain.
create or replace function pg_temp.repair_unstarted_password_change(
  p_receipt_id uuid,
  p_expected_created_at timestamptz,
  p_expected_updated_at timestamptz,
  p_expected_password_version text,
  p_drained_before timestamptz
) returns boolean
language plpgsql
security invoker
set search_path = pg_catalog
as $$
declare
  v_command private.password_change_commands%rowtype;
  v_profile public.profiles%rowtype;
  v_version private.auth_password_versions%rowtype;
begin
  if p_receipt_id is null or p_expected_created_at is null
    or p_expected_updated_at is null or p_expected_password_version is null
    or p_expected_password_version !~ '^[0-9a-f]{64}$'
    or p_drained_before is null
    or p_drained_before > clock_timestamp() - interval '15 minutes'
    or p_expected_created_at >= p_drained_before then
    raise exception 'PASSWORD_REPAIR_EVIDENCE_REQUIRED';
  end if;
  select * into strict v_command from private.password_change_commands where id=p_receipt_id;
  if not pg_try_advisory_xact_lock(hashtextextended('password-change:' || v_command.actor_profile_id::text,0)) then
    raise exception 'PASSWORD_REPAIR_BUSY';
  end if;
  select * into strict v_profile from public.profiles where id=v_command.actor_profile_id for update nowait;
  select * into strict v_command from private.password_change_commands where id=p_receipt_id for update nowait;
  -- Lock Auth updates and the shadow version. NOWAIT avoids waiting on reset lock inversions.
  perform 1 from auth.users where id=v_command.auth_user_id for update nowait;
  if not found then raise exception 'PASSWORD_REPAIR_STATE_CHANGED'; end if;
  select * into strict v_version from private.auth_password_versions where auth_user_id=v_command.auth_user_id for update nowait;
  if v_profile.auth_user_id <> v_command.auth_user_id or v_profile.status <> 'active'
    or v_profile.role not in ('admin','maid') or not v_profile.must_change_password
    or v_command.created_at <> p_expected_created_at
    or v_command.updated_at <> p_expected_updated_at
    or v_command.state <> 'auth_pending' or v_command.attempt_count <> 1
    or v_command.failure_code is not null or v_command.completed_at is not null
    or v_command.reset_command_execution_id is not null
    or v_command.lease_expires_at is null or v_command.lease_expires_at >= p_drained_before
    or v_version.password_version <> p_expected_password_version
    or v_version.password_version = v_command.effect_marker
    or v_version.rotated_at > v_command.created_at
    or exists(select 1 from private.password_reset_auth_markers where target_profile_id=v_profile.id and state='prepared') then
    raise exception 'PASSWORD_REPAIR_STATE_CHANGED';
  end if;
  update private.password_change_commands
  set state='failed', claim_digest=null, lease_expires_at=null,
    failure_code='AUTH_PASSWORD_CHANGE_FAILED', updated_at=clock_timestamp()
  where id=v_command.id;
  return true;
end;
$$;
revoke all on function pg_temp.repair_unstarted_password_change(uuid,timestamptz,timestamptz,text,timestamptz)
from public,anon,authenticated,service_role;
